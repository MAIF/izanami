{
  "name": "izanami-frontend",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "compile": "tsc",
    "build": "tsc && vite build && mkdir -p ../public && rm -rf ../public/* &&  cp -r ./dist/* ../public/ && cp ../swagger.json ../public/",
    "preview": "vite preview",
    "test": "BACKEND_URL=http://localhost:9000 playwright test --workers 1 --trace on",
    "test:ci": "playwright test --workers 1 --trace on",
    "screenshots": "npx tsx ./tests/screenshots/index.ts",
    "lint": "eslint ./src --ext .js,.jsx,.ts,.tsx",
    "unit-tests": "vitest"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@hookform/error-message": "^2.0.1",
    "@maif/react-forms": "1.7.7",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-table": "^8.21.2",
    "@textea/json-viewer": "^4.0.1",
    "@uiw/react-codemirror": "^4.25.12",
    "@codemirror/lint": "^6.9.7",
    "@xiechao/codemirror-lang-handlebars": "^1.0.4",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "classnames": "^2.5.1",
    "date-fns": "^4.4.0",
    "handlebars": "^4.7.10",
    "lodash": "^4.18.1",
    "react": "19.3.1",
    "react-codemirror-merge": "^4.25.12",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-hot-toast": "^2.6.1",
    "react-router-dom": "7.18.4",
    "react-select": "^5.10.2",
    "react-tooltip": "^5.28.0",
    "swagger-ui": "^5.34.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.23.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.13.13",
    "@types/react-dom": "^19.3.0",
    "@types/swagger-ui": "^5.32.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vitejs/plugin-react": "^4.3.4",
